{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glowfin.local/schemas/art-budgets.schema.json",
  "title": "Glowfin Phase 3 art-gate configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "sourceOfTruth",
    "scene",
    "camera",
    "lod",
    "colliderTruth",
    "contrast",
    "beauty",
    "worldQuality",
    "creature",
    "merfolk",
    "trail",
    "performance",
    "assetFamilies",
    "captureTiers"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "configVersion": { "type": "string", "minLength": 1 },
    "sourceOfTruth": { "type": "string", "minLength": 1 },
    "scene": { "type": "object" },
    "camera": { "type": "object" },
    "lod": { "type": "object" },
    "colliderTruth": { "type": "object" },
    "contrast": { "type": "object" },
    "beauty": { "type": "object" },
    "worldQuality": {
      "type": "object",
      "required": [
        "requiredGateFamilies",
        "requiredArchitecture",
        "requiredReef",
        "requiredLife",
        "requiredProps",
        "requiredMaterials",
        "minimumDistinctVisibleGateFamilies",
        "minimumDistinctReefFamilies",
        "minimumAmbientLifeFamilies",
        "minimumPropFamilies"
      ]
    },
    "creature": { "type": "object" },
    "merfolk": {
      "type": "object",
      "required": [
        "minimumReadableHeightPixels",
        "minimumFaceHeightPixels",
        "minimumEyeDiameterPixels",
        "minimumGuardianIdentitySpanPixels",
        "minimumGuardianVisiblePixels",
        "minimumCitizenHeightPixels",
        "minimumCitizenVisiblePixels",
        "minimumSwimmerWidthPixels",
        "minimumSwimmerVisiblePixels",
        "minimumSwimmerFaceHeightPixels",
        "minimumSwimmerEyeHeightPixels",
        "minimumHeraldHeightPixels",
        "minimumHeraldVisiblePixels",
        "minimumPopulationFaceHeightPixels",
        "minimumPopulationEyeHeightPixels",
        "minimumPopulationInstancesPerRole",
        "minimumUprightAspectRatio",
        "minimumSwimmerHorizontalAspectRatio",
        "minimumSwimmerCentreSeparationPixels",
        "maximumSwimmerBoxOverlapFraction",
        "motionSampleIntervalSec",
        "minimumSwimmerTravelPixels",
        "maximumAnchoredTravelPixels",
        "minimumSwimmerTravelDifferencePixels",
        "maximumGuardianOcclusionFraction",
        "maximumPopulationOcclusionFraction",
        "minimumGuardianEdgeClearancePixels",
        "maxArticulatedJoints",
        "maxMaterials",
        "requiredRecognitionLabel",
        "requiredGuardianRoles",
        "requiredPopulationRoles",
        "requiredParts",
        "requiredStates",
        "requiredClips",
        "animationDriver"
      ]
    },
    "trail": { "type": "object" },
    "performance": { "type": "object" },
    "assetFamilies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["lod0", "lod1", "lod2", "maxMaterials", "strategy", "collidable"]
      }
    },
    "captureTiers": {
      "type": "object",
      "required": ["structural", "fast", "full", "signoff"],
      "additionalProperties": {
        "type": "object",
        "required": [
          "requireCaptures",
          "acceptedSourceKinds",
          "devices",
          "expectedStates",
          "requireRealDevice",
          "requiredSoakMinutes"
        ]
      }
    }
  }
}
