# Git LFS tracking for Glowfin binary assets
# Per Part 5.2: LFS is configured at Phase 0, before any binary assets land in history.

# 3D models
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text

# Textures / images
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.basis filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text

# Audio
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Video (marketing / capture clips, not runtime assets)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Design source files
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.aep filter=lfs diff=lfs merge=lfs -text

# Temporary Phase 3B visual-review sources and their two packed runtime atlases
# stay as ordinary Git blobs so PR previews/checkouts do not depend on
# unpublished LFS objects. Final production textures and all GLBs remain
# LFS-tracked.
docs/art/*.webp -filter -diff -merge -text
docs/art/*.png -filter -diff -merge -text
public/art/moon-garden/*.webp -filter -diff -merge -text
public/art/moon-garden/*.png -filter -diff -merge -text

# Note: small UI/marketing SVGs and icons are intentionally left as regular
# git text files (diffable). Reassess if that stops being true.
