{
  "name": "glowfin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Glowfin — one-swipe endless bioluminescent surf game (Three.js)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run art:build-runtime-glbs",
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs && npm run art:build-runtime-glbs",
    "build": "tsc --noEmit && vite build --emptyOutDir && node scripts/seal-release-manifest.mjs",
    "build:hosted-verifier": "vite build --config vite.verifier.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern build --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "art-gate:fixtures": "node --experimental-strip-types tools/art-gate/fixtures/generate.ts",
    "art-gate:test": "npm run art-gate:fixtures && node --experimental-strip-types --test tools/art-gate/test/*.node.ts",
    "art-gate:evidence": "node --experimental-strip-types tools/art-gate/integration/buildStructuralEvidence.ts --output build/art-gate-structural.json",
    "art-gate:structural": "npm run art-gate:evidence && node --experimental-strip-types tools/art-gate/src/cli.ts --config tools/art-gate/config/art-budgets.json --input build/art-gate-structural.json --tier structural",
    "art-gate:capture:fast": "node --experimental-strip-types tools/art-gate/integration/capture.mjs --tier fast --output build/art-gate-fast.json --screenshot build/art-gate-fast.png",
    "art-gate:capture:full": "node --experimental-strip-types tools/art-gate/integration/capture.mjs --tier full --output build/art-gate-full.json --screenshot build/art-gate-full.png",
    "art-gate:run:fast": "node --experimental-strip-types tools/art-gate/src/cli.ts --config tools/art-gate/config/art-budgets.json --input build/art-gate-fast.json --tier fast",
    "art-gate:run:full": "node --experimental-strip-types tools/art-gate/src/cli.ts --config tools/art-gate/config/art-budgets.json --input build/art-gate-full.json --tier full",
    "art-gate:soak": "node --experimental-strip-types tools/art-gate/integration/soak.mjs --minutes 30 --render-fps 3 --output build/art-gate-soak.json --report build/art-gate-soak-report.txt",
    "audio-gate:browser": "node tools/audio-gate/integration/capture.mjs",
    "runtime-gate:browser": "node scripts/check-runtime-recovery.mjs",
    "runtime-gate:tide-sprint": "node scripts/check-tide-sprint-browser.mjs",
    "soak:tide-sprint": "node scripts/soak-tide-sprint-renderer.mjs",
    "art:export-glbs": "node --experimental-strip-types tools/art/exportProductionGlbs.mjs",
    "art:pack-runtime-glbs": "node --experimental-strip-types tools/art/packRuntimeGlbs.mjs",
    "art:publish-runtime-glbs": "node tools/art/publishRuntimeGlbs.mjs",
    "art:build-runtime-glbs": "npm run art:export-glbs && npm run art:pack-runtime-glbs && npm run art:publish-runtime-glbs && npm run art:verify-runtime-glbs",
    "art:verify-runtime-glbs": "node tools/art/verifyRuntimeGlbs.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:no-debug": "node scripts/check-no-debug.mjs",
    "check:mounted-build": "node scripts/check-mounted-build.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:hosted-verifier": "node scripts/check-hosted-verifier.mjs",
    "check:native-wrapper": "node scripts/check-native-wrapper.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "check:rollback-rehearsal": "node scripts/check-rollback-rehearsal.mjs",
    "production-gate": "vitest run tests/networkPolicy.test.ts tests/productionReadiness.test.ts tests/productionJourney.test.ts tests/rewardAuthority.test.ts tests/retentionJourney.test.ts tests/cloud.test.ts tests/rewardedIntegration.test.ts && npm run check:rollback-rehearsal",
    "native:sync": "npm run build && cap sync",
    "native:copy": "npm run build && cap copy",
    "native:doctor": "cap doctor",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "certify:phase3": "npm run lint && npm run typecheck && npm run test -- --run && npm run build && cap sync && npm run check:native-wrapper && npm run build:hosted-verifier && npm run check:hosted-verifier && npm run check:mounted-build && npm run check:bundle-size && npm run check:no-debug && npm run check:release-metadata && npm run production-gate && npm run art-gate:test && npm run art-gate:structural"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.62.0",
    "@types/three": "^0.165.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
